<?xml version="1.0" encoding="utf-8"?>
<!-- Scrapbook canvas: corkboard/kraft paper texture (solid warm tan, thin inner border) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer shadow -->
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="-3dp">
        <shape android:shape="rectangle">
            <solid android:color="#22000000" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Corkboard background fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EAE0CE" />
            <stroke android:width="6dp" android:color="#D4B896" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Inner kraft-paper texture hint (slightly lighter centre) -->
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#F0E8D8" />
            <stroke android:width="1dp" android:color="#D8CCBA" />
        </shape>
    </item>
</layer-list>