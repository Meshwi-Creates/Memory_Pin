<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EFF5">

    <!-- ================= HEADER ================= -->

    <TextView
        android:id="@+id/tvArrangeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Make Your Memory"
        android:textColor="#403B43"
        android:textSize="23sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvArrangeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tap an element • Drag to move • Use controls below"
        android:textColor="#777177"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/tvArrangeTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ================= SCRAPBOOK CANVAS ================= -->

    <FrameLayout
        android:id="@+id/memoryCanvas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/memory_canvas_background"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvArrangeHint"
        app:layout_constraintBottom_toTopOf="@id/photoControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ================= EDIT CONTROLS ================= -->

    <LinearLayout
        android:id="@+id/photoControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        app:layout_constraintBottom_toTopOf="@id/btnSaveArrangement"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- CONTROL LABEL -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selected Element"
            android:textColor="#777177"
            android:textSize="11sp"
            android:layout_marginBottom="3dp" />

        <!-- CONTROL BUTTONS -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnPhotoSmall"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="−"
                android:textColor="@color/white"
                android:textSize="21sp" />

            <Button
                android:id="@+id/btnPhotoBig"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="@color/white"
                android:textSize="21sp" />

            <Button
                android:id="@+id/btnPhotoRotate"
                android:layout_width="58dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="↻"
                android:textColor="@color/white"
                android:textSize="21sp" />

            <Button
                android:id="@+id/btnEditText"
                android:layout_width="58dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="✎"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnPhotoDelete"
                android:layout_width="58dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="⌫"
                android:textColor="@color/white"
                android:textSize="19sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ================= SAVE ================= -->

    <Button
        android:id="@+id/btnSaveArrangement"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="#5D5363"
        android:elevation="3dp"
        android:text="SAVE MEMORY"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>