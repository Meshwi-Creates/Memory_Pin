<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCF5FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="18dp"
        android:paddingBottom="28dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MEMORY PIN"
                android:textColor="#403B43"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Your Travel Memories"
                android:textColor="#777177"
                android:textSize="14sp"
                android:letterSpacing="0.02" />

        </LinearLayout>

        <!-- SMALL DIVIDER -->
        <View
            android:layout_width="42dp"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:layout_marginTop="14dp"
            android:background="#D8C9DC" />

        <!-- EMPTY STATE -->
        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="70dp"
            android:text="📍 No memories yet"
            android:textColor="#777177"
            android:textSize="19sp"
            android:visibility="gone" />

        <!-- MEMORY GRID -->
        <GridLayout
            android:id="@+id/memoryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:columnCount="3"
            android:orientation="horizontal"
            android:useDefaultMargins="false" />

        <!-- CREATE BUTTON -->
        <Button
            android:id="@+id/btnCreateMemory"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#5D5363"
            android:elevation="3dp"
            android:text="+  Create Memory"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>