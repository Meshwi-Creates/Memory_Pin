<?xml version="1.0" encoding="utf-8"?>
<!--
 ╔══════════════════════════════════════════════════════════════════════╗
 ║  STICKER PALETTE SELECTION MODAL / ACTIVITY                         ║
 ║  Layout: activity_sticker.xml                                       ║
 ║  Theme:  Scrapbook / Craft-paper (#FDFBF7)                          ║
 ╚══════════════════════════════════════════════════════════════════════╝
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mp_cream"
    tools:context=".StickerActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding_horizontal"
            android:paddingEnd="@dimen/page_padding_horizontal"
            android:paddingTop="@dimen/page_padding_top"
            android:paddingBottom="@dimen/page_padding_bottom">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStickerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sticker Palette"
                        android:textColor="@color/mp_text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:fontFamily="serif" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Tap to select up to 8 craft stickers ✨"
                        android:textColor="@color/mp_text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="serif"
                        android:textStyle="italic" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvStickerCount"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:text="Selected: 0 / 8"
                    android:textColor="@color/mp_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:layout_width="48dp"
                android:layout_height="2dp"
                android:layout_marginTop="12dp"
                android:background="@color/mp_mauve_light" />

            <!-- STICKERS GRID CONTAINER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:background="@drawable/bg_scrapbook_card"
                android:elevation="@dimen/elevation_card"
                android:padding="@dimen/card_inner_padding">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@color/mp_parchment">

                        <ImageView
                            android:id="@+id/sticker1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/map"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/cd_sticker"
                            android:clickable="true"
                            android:focusable="true" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="@color/mp_parchment">

                        <ImageView
                            android:id="@+id/sticker2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/airplane"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/cd_sticker"
                            android:clickable="true"
                            android:focusable="true" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@color/mp_parchment">

                        <ImageView
                            android:id="@+id/sticker3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/suitcase"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/cd_sticker"
                            android:clickable="true"
                            android:focusable="true" />
                    </FrameLayout>

                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@color/mp_parchment">

                        <ImageView
                            android:id="@+id/sticker4"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/mountain"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/cd_sticker"
                            android:clickable="true"
                            android:focusable="true" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="@color/mp_parchment">

                        <ImageView
                            android:id="@+id/sticker5"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/wave"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/cd_sticker"
                            android:clickable="true"
                            android:focusable="true" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@color/mp_parchment">

                        <ImageView
                            android:id="@+id/sticker6"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ticket"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/cd_sticker"
                            android:clickable="true"
                            android:focusable="true" />
                    </FrameLayout>

                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@color/mp_parchment">

                        <ImageView
                            android:id="@+id/sticker7"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/globe"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/cd_sticker"
                            android:clickable="true"
                            android:focusable="true" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="@color/mp_parchment">

                        <ImageView
                            android:id="@+id/sticker8"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/camera"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/cd_sticker"
                            android:clickable="true"
                            android:focusable="true" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@color/mp_parchment">

                        <ImageView
                            android:id="@+id/sticker9"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/heart"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/cd_sticker"
                            android:clickable="true"
                            android:focusable="true" />
                    </FrameLayout>

                </LinearLayout>

                <!-- Row 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@color/mp_parchment">

                        <ImageView
                            android:id="@+id/sticker10"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/pin"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/cd_sticker"
                            android:clickable="true"
                            android:focusable="true" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="@color/mp_parchment">

                        <ImageView
                            android:id="@+id/sticker11"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/sunglasses"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/cd_sticker"
                            android:clickable="true"
                            android:focusable="true" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@color/mp_parchment">

                        <ImageView
                            android:id="@+id/sticker12"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/polaroid"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/cd_sticker"
                            android:clickable="true"
                            android:focusable="true" />
                    </FrameLayout>

                </LinearLayout>

                <!-- Row 5 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@color/mp_parchment">

                        <ImageView
                            android:id="@+id/sticker13"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/sun"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/cd_sticker"
                            android:clickable="true"
                            android:focusable="true" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="@color/mp_parchment">

                        <ImageView
                            android:id="@+id/sticker14"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/palm"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/cd_sticker"
                            android:clickable="true"
                            android:focusable="true" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@color/mp_parchment">

                        <ImageView
                            android:id="@+id/sticker15"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/rainbow"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:contentDescription="@string/cd_sticker"
                            android:clickable="true"
                            android:focusable="true" />
                    </FrameLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- DONE CTA -->
            <Button
                android:id="@+id/btnDoneStickers"
                style="@style/Widget.MemoryPin.Button.PrimaryLarge"
                android:layout_width="match_parent"
                android:layout_height="@dimen/btn_height_large"
                android:layout_marginTop="24dp"
                android:text="Save Selected Stickers  ✓" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>