<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
         Base Application Theme — Scrapbook Craft Style
         ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <style name="Base.Theme.Memory_Pin" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color (terracotta) -->
        <item name="colorPrimary">@color/mp_terracotta</item>
        <item name="colorPrimaryVariant">@color/mp_terracotta_dark</item>
        <item name="colorOnPrimary">@color/mp_text_on_dark</item>

        <!-- Secondary (mauve) -->
        <item name="colorSecondary">@color/mp_mauve</item>
        <item name="colorSecondaryVariant">@color/mp_mauve_dark</item>
        <item name="colorOnSecondary">@color/mp_text_on_dark</item>

        <!-- Backgrounds — parchment / cream -->
        <item name="android:colorBackground">@color/mp_cream</item>
        <item name="colorSurface">@color/mp_card</item>
        <item name="colorOnSurface">@color/mp_text_primary</item>
        <item name="colorSurfaceVariant">@color/mp_parchment</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/mp_text_primary</item>
        <item name="android:textColorSecondary">@color/mp_text_secondary</item>
        <item name="android:textColorHint">@color/mp_text_hint</item>

        <!-- Status / nav bars -->
        <item name="android:statusBarColor">@color/mp_cream</item>
        <item name="android:navigationBarColor">@color/mp_cream</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <!-- Ripple using terracotta at 20% alpha -->
        <item name="colorControlHighlight">#33E27D60</item>

        <!-- Shape overrides -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeSmall</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeMedium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeLarge</item>
    </style>

    <style name="Theme.Memory_Pin" parent="Base.Theme.Memory_Pin" />

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
         Shape Appearances
         ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <style name="ShapeSmall" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/radius_small</item>
    </style>

    <style name="ShapeMedium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/radius_medium</item>
    </style>

    <style name="ShapeLarge" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">@dimen/radius_large</item>
    </style>

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
         Button Styles
         ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->

    <!-- Primary CTA — Terracotta filled -->
    <style name="Widget.MemoryPin.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/mp_terracotta</item>
        <item name="android:textColor">@color/mp_text_on_dark</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/btn_height</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">@dimen/elevation_card</item>
    </style>

    <!-- Primary CTA Large — for single-action screens -->
    <style name="Widget.MemoryPin.Button.PrimaryLarge" parent="Widget.MemoryPin.Button.Primary">
        <item name="android:minHeight">@dimen/btn_height_large</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Secondary — Mauve light tonal -->
    <style name="Widget.MemoryPin.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/mp_tab_inactive</item>
        <item name="android:textColor">@color/mp_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">@dimen/btn_height</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Outlined — ghost button -->
    <style name="Widget.MemoryPin.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/mp_terracotta</item>
        <item name="android:textColor">@color/mp_terracotta</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">@dimen/btn_height</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Icon Button — transparent, circular -->
    <style name="Widget.MemoryPin.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">@dimen/touch_target_min</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <!-- Canvas Control Button -->
    <style name="Widget.MemoryPin.Button.Canvas" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/mp_dock_bg</item>
        <item name="android:textColor">@color/mp_text_on_dark</item>
        <item name="android:minWidth">@dimen/canvas_ctrl_btn_size</item>
        <item name="android:minHeight">@dimen/canvas_ctrl_btn_size</item>
        <item name="cornerRadius">@dimen/radius_small</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Canvas Destructive Button -->
    <style name="Widget.MemoryPin.Button.Canvas.Destructive" parent="Widget.MemoryPin.Button.Canvas">
        <item name="backgroundTint">@color/mp_terracotta</item>
    </style>

    <!-- Save Button — dark filled for canvas top bar -->
    <style name="Widget.MemoryPin.Button.Save" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/mp_terracotta</item>
        <item name="android:textColor">@color/mp_text_on_dark</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">40dp</item>
        <item name="cornerRadius">@dimen/radius_small</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
         Text Styles
         ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <style name="TextAppearance.MemoryPin.Display" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/mp_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <style name="TextAppearance.MemoryPin.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/mp_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.MemoryPin.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/mp_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.MemoryPin.Subtitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/mp_text_secondary</item>
    </style>

    <style name="TextAppearance.MemoryPin.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/mp_text_primary</item>
    </style>

    <style name="TextAppearance.MemoryPin.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/mp_text_secondary</item>
    </style>

    <style name="TextAppearance.MemoryPin.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/mp_text_secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.MemoryPin.Tagline" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/mp_text_secondary</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">italic</item>
    </style>

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
         EditText / TextInputLayout Style
         ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <style name="Widget.MemoryPin.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/mp_border</item>
        <item name="boxBackgroundColor">@color/mp_card</item>
        <item name="hintTextColor">@color/mp_text_secondary</item>
        <item name="android:textColorHint">@color/mp_text_hint</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
    </style>

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
         Chip Styles
         ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <style name="Widget.MemoryPin.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/mp_chip_bg</item>
        <item name="android:textColor">@color/mp_text_secondary</item>
        <item name="chipStrokeColor">@color/mp_border</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">@dimen/chip_height</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <style name="Widget.MemoryPin.Chip.Selected" parent="Widget.MemoryPin.Chip">
        <item name="chipBackgroundColor">@color/mp_chip_selected_bg</item>
        <item name="android:textColor">@color/mp_chip_selected_text</item>
        <item name="chipStrokeColor">@color/mp_terracotta_dark</item>
    </style>

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
         Tab Layout Style
         ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <style name="Widget.MemoryPin.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabBackground">@color/mp_parchment</item>
        <item name="tabSelectedTextColor">@color/mp_text_on_dark</item>
        <item name="tabTextColor">@color/mp_text_secondary</item>
        <item name="tabIndicatorColor">@color/mp_terracotta</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabRippleColor">#33E27D60</item>
        <item name="tabTextAppearance">@style/TextAppearance.MemoryPin.Body</item>
    </style>

    <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
         Search Bar Style
         ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
    <style name="Widget.MemoryPin.SearchBar" parent="Widget.Material3.SearchBar">
        <item name="android:background">@color/mp_card</item>
        <item name="strokeColor">@color/mp_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:elevation">@dimen/elevation_card</item>
    </style>
</resources>